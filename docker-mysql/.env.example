#!/usr/bin/env bash

# ===========================
# MySQL 基础配置
# ===========================

# 镜像版本
MYSQL_IMAGE=mysql:8.0


# 容器名称
MYSQL_CONTAINER_NAME=docker-mysql


# 数据库名称
MYSQL_DATABASE=newbee_mall_db_v2


# root密码
MYSQL_ROOT_PASSWORD=nyh123


# 普通用户
MYSQL_USER=newbee


# 普通用户密码
MYSQL_PASSWORD=newbee123



# ===========================
# 端口配置
# ===========================

# 宿主机端口
MYSQL_PORT=33060


# 容器端口
MYSQL_CONTAINER_PORT=3306



# ===========================
# 时区/字符集
# ===========================

TZ=Asia/Shanghai

MYSQL_CHARSET=utf8mb4

MYSQL_COLLATION=utf8mb4_unicode_ci



# ===========================
# 数据持久化
# ===========================

MYSQL_DATA_PATH=./data/db/mysql


# ===========================
# Redis 配置
# ===========================

# 镜像版本
REDIS_IMAGE=redis:7-alpine


# 容器名称
REDIS_CONTAINER_NAME=docker-redis


# Redis 密码
REDIS_PASSWORD=redis123


# 宿主机端口
REDIS_PORT=63790


# 容器端口
REDIS_CONTAINER_PORT=6379


# 数据持久化路径
REDIS_DATA_PATH=./data/redis
